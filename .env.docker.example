# Copy to .env.docker. Replace every placeholder locally; never commit secrets.
POSTGRES_DB=YOUR_POSTGRES_DATABASE
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET

# Use the Compose service hostname, not localhost.
DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/YOUR_POSTGRES_DATABASE

JWT_SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FOOD_RECOGNITION_PROVIDER=mock
FOOD_RECOGNITION_MAX_UPLOAD_BYTES=5242880
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20

NUTRITION_COACH_PROVIDER=mock

# Optional, only for explicitly configured isolated tests.
# TEST_DATABASE_URL=
