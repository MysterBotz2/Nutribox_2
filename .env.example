# Replace every placeholder with the PostgreSQL values you created manually.
# Do not commit the copied .env file.
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE

# Phase 4 development-only food recognition settings.
FOOD_RECOGNITION_PROVIDER=mock
FOOD_RECOGNITION_MAX_UPLOAD_BYTES=5242880

# Phase 14 optional Gemini food-recognition settings. Keep mock as the default.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional USDA FoodData Central fallback. Keep disabled unless a backend-only key is set.
USDA_FDC_ENABLED=false
USDA_FDC_API_KEY=
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_FDC_TIMEOUT_SECONDS=10

# Phase 12 development-only nutrition coach setting.
NUTRITION_COACH_PROVIDER=mock
# Set provider to gemini only on the backend with a real server-side key.
NUTRITION_COACH_GEMINI_API_KEY=
NUTRITION_COACH_GEMINI_MODEL=
NUTRITION_COACH_GEMINI_TIMEOUT_SECONDS=20

# Backend-only device pairing secret. Generate a long random value locally.
DEVICE_PAIRING_SECRET=
DEVICE_PAIRING_TTL_SECONDS=300

# Optional: a separate PostgreSQL database used only by integration tests.
# Never point this at the normal development database.
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USERNAME:TEST_PASSWORD@TEST_HOST:TEST_PORT/TEST_DATABASE

# Phase 9 authentication settings. Generate a secret locally; do not commit it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Explicit comma-separated browser origins for the optional React web client.
# Leave blank to disable browser CORS access; never use a wildcard here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
